# =============================================================================
# kimi-ai-2api Deno 版本环境变量模板
# =============================================================================

# ----------------------
# 服务运行配置
# ----------------------
PORT=9090
DEBUG_MODE=false
DEBUG_LOG_NONCE_HTML=false
DEFAULT_STREAM=true
DASHBOARD_ENABLED=true

# ----------------------
# 鉴权与缓存
# ----------------------
API_MASTER_KEY=sk-kimi-ai-2api-default-key-please-change-me
SESSION_CACHE_TTL=3600
CONTEXT_MAX_LENGTH=1000

# ----------------------
# 上游接口配置
# ----------------------
UPSTREAM_URL=https://kimi-ai.chat/wp-admin/admin-ajax.php
CHAT_PAGE_URL=https://kimi-ai.chat/chat/
API_REQUEST_TIMEOUT=180
DEFAULT_MODEL=kimi-k2-instruct-0905
KNOWN_MODELS=kimi-k2-instruct-0905,kimi-k2-instruct

# ----------------------
# 品牌信息（可选）
# ----------------------
SERVICE_NAME=kimi-ai-2api
SERVICE_EMOJI=🤖
FOOTER_TEXT=连接世界，创造未来
DISCUSSION_URL=https://linux.do/t/topic/1068201
GITHUB_REPO=https://github.com/lzA6/kimi-ai-2api
